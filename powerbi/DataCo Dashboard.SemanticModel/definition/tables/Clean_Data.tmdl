	partition Clean_Data = m
		mode: import
		source =
				let
				    // Pull the already-cleaned table straight out of the Excel workbook - no
				    // transformation logic here, the cleaning was done with formulas in Excel.
				    Source = Excel.Workbook(File.Contents(DataFolder & "DataCo_Cleaned.xlsx"), null, true),
				    CleanData_Table = Source{[Item = "CleanData", Kind = "Table"]}[Data],
				    // Excel.Workbook's automatic type detection isn't reliable column by column
				    // (it guessed "text" for some number columns), so every column is typed
				    // explicitly here instead of trusting the auto-detected types.
				    #"Changed Types" = Table.TransformColumnTypes(
				        CleanData_Table,
				        {
				            {"Order Id", Int64.Type}, {"Order Item Id", Int64.Type},
				            {"Order Date", type date}, {"Shipping Date", type date},
				            {"Shipping Mode", type text},
				            {"Days to Ship (Actual)", Int64.Type}, {"Days to Ship (Scheduled)", Int64.Type},
				            {"Shipping Delay (Days)", Int64.Type},
				            {"On-Time Flag", type text}, {"Order Status", type text}, {"Is Cancelled", type text},
				            {"Category", type text}, {"Product Name", type text},
				            {"Product Price", type number}, {"Quantity", Int64.Type},
				            {"Discount Rate", type number}, {"Discount Amount", type number},
				            {"Order Item Total", type number}, {"Order Profit", type number},
				            {"Profit Margin %", type number},
				            {"Customer Segment", type text}, {"Customer City", type text},
				            {"Customer State", type text}, {"Customer Country", type text},
				            {"Ship-To Country", type text}, {"Order Region", type text}, {"Market", type text},
				            {"Order Year", Int64.Type}, {"Order Month", type text}, {"Data Quality Flag", type text}
				        },
				        "en-US"
				    )
				in
				    #"Changed Types"

	annotation PBI_ResultType = Table

