/// The one cleaned table, imported straight from DataCo_Cleaned.xlsx. All cleaning (XLOOKUP, IF, IFERROR, dates) was done in Excel.
table Clean_Data
	lineageTag: 249b8db3-6d55-4636-bf54-640db716cc7c

	/// Sum of order line totals, excluding cancelled orders.
	measure 'Total Sales' = CALCULATE ( SUM ( 'Clean_Data'[Order Item Total] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: \$#,0
		lineageTag: f7674a15-28c3-4311-95c5-0fee0d47848f

	/// Sum of order line profit, excluding cancelled orders.
	measure 'Total Profit' = CALCULATE ( SUM ( 'Clean_Data'[Order Profit] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: \$#,0
		lineageTag: 9afc3c1f-8fff-4f8f-b762-1be0a2a9957e

	/// Total Profit as a share of Total Sales.
	measure 'Profit Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%
		lineageTag: 8547028d-4d6f-4f5a-94e9-f150f7f600ec

	/// Distinct orders that were not cancelled.
	measure 'Total Orders' = CALCULATE ( DISTINCTCOUNT ( 'Clean_Data'[Order Id] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: #,0
		lineageTag: f237fa32-a18d-4002-9fc6-7e92cac8d16e

	/// Total quantity sold, excluding cancelled orders.
	measure 'Total Units Sold' = CALCULATE ( SUM ( 'Clean_Data'[Quantity] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: #,0
		lineageTag: f82e1f3a-eea6-4e47-b1a5-cb9201330df8

	/// Total Sales divided by Total Orders.
	measure 'Average Order Value' = DIVIDE ( [Total Sales], [Total Orders] )
		formatString: \$#,0.00
		lineageTag: d556bffc-152e-4918-af41-3d2ec9d3b994

	/// Sum of the discount amount, excluding cancelled orders.
	measure 'Total Discount Given' = CALCULATE ( SUM ( 'Clean_Data'[Discount Amount] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: \$#,0
		lineageTag: e58b2118-6fa5-4c3b-bad5-021b217de5b2

	/// Orders that took longer than the shipping mode's scheduled days.
	measure 'Late Orders' = CALCULATE ( DISTINCTCOUNT ( 'Clean_Data'[Order Id] ), 'Clean_Data'[Is Cancelled] = "No", 'Clean_Data'[On-Time Flag] = "Late" )
		formatString: #,0
		lineageTag: 44fcc16f-ced7-4fc8-b8fb-982b3d88ae50

	/// Share of orders that arrived late.
	measure 'Late Delivery %' = DIVIDE ( [Late Orders], [Total Orders] )
		formatString: 0.0%
		lineageTag: fc4fba99-134a-4d3a-bd35-24c695ec1840

	/// Distinct orders with status Cancelled.
	measure 'Cancelled Orders' = CALCULATE ( DISTINCTCOUNT ( 'Clean_Data'[Order Id] ), 'Clean_Data'[Is Cancelled] = "Yes" )
		formatString: #,0
		lineageTag: fc3e1d5b-4ee2-4dcd-9a7d-2386bb455301

	/// Total Sales for the same period last year.
	measure 'Sales Last Year' = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0
		lineageTag: 0c667f2c-feb6-4eef-8436-c3ee9a8eae70

	/// Growth in Total Sales versus the same period last year.
	measure 'Sales YoY %' = DIVIDE ( [Total Sales] - [Sales Last Year], [Sales Last Year] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 27027312-9dbd-46b3-a303-3666dc061735

	/// Year-to-date sales up to the latest date in the current selection.
	measure 'Sales YTD' = TOTALYTD ( [Total Sales], 'Date'[Date] )
		formatString: \$#,0
		lineageTag: c7b1d8c6-8065-460c-ba4a-21a30771790c

	/// Average monthly sales over the trailing 3 months (smooths out month-to-month noise).
	measure 'Sales 3M Rolling Avg' =
			VAR LastVisibleDate = MAX ( 'Date'[Date] )
			VAR Last3Months = DATESINPERIOD ( 'Date'[Date], LastVisibleDate, -3, MONTH )
			VAR Sales3M = CALCULATE ( [Total Sales], Last3Months )
			VAR MonthCount = CALCULATE ( DISTINCTCOUNT ( 'Date'[Year Month] ), Last3Months )
			RETURN
			    DIVIDE ( Sales3M, MonthCount )
		formatString: \$#,0
		lineageTag: 7d6c0c8a-676e-4657-8f78-d1cd0cc1c7c2

	/// Share of orders that arrived on schedule or early.
	measure 'On-Time Delivery %' = 1 - [Late Delivery %]
		formatString: 0.0%
		lineageTag: db65d6c3-6395-478a-9dd2-be01ef1a52ae

	/// Average shipping days promised to the customer.
	measure 'Avg Scheduled Days' = CALCULATE ( AVERAGE ( 'Clean_Data'[Days to Ship (Scheduled)] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: 0.00
		lineageTag: 9df2ae04-ec35-48a9-ad72-4a4ddfe7f41e

	/// Average shipping days actually taken.
	measure 'Avg Actual Days' = CALCULATE ( AVERAGE ( 'Clean_Data'[Days to Ship (Actual)] ), 'Clean_Data'[Is Cancelled] = "No" )
		formatString: 0.00
		lineageTag: 40869abe-5402-4c3e-b3de-1342f91c3fb8

	/// Actual minus scheduled shipping days. Positive = slower than promised.
	measure 'Avg Delay Days' = [Avg Actual Days] - [Avg Scheduled Days]
		formatString: +0.00;-0.00;0.00
		lineageTag: bd802cbe-8710-4a63-b518-2d5468eda044

	/// Rank of each product by sales within the current selection (1 = highest). Use this in a table/matrix that groups by Product Name.
	measure 'Product Revenue Rank' =
			IF (
			    ISINSCOPE ( 'Clean_Data'[Product Name] ) && NOT ISBLANK ( [Total Sales] ),
			    RANKX ( ALLSELECTED ( 'Clean_Data'[Product Name] ), [Total Sales], , DESC, DENSE )
			)
		formatString: 0
		lineageTag: d6486f9d-f892-4db3-ab81-fed159ab4ca5

	/// Rank of the one selected product against every product. Use this on a card or the drill-through page (ISINSCOPE doesn't apply there since nothing is grouped).
	measure 'Revenue Rank (Selected Product)' =
			VAR SelectedProductSales = [Total Sales]
			RETURN
			    IF (
			        HASONEVALUE ( 'Clean_Data'[Product Name] ) && NOT ISBLANK ( SelectedProductSales ),
			        COUNTROWS ( FILTER ( ALL ( 'Clean_Data'[Product Name] ), [Total Sales] > SelectedProductSales ) ) + 1
			    )
		formatString: 0
		lineageTag: c4343092-715a-4ee7-b120-4a7cb2838265

	/// Pareto share: this product's sales plus every product that sells more, as a share of total sales.
	measure 'Cumulative Sales %' =
			VAR CurrentSales = [Total Sales]
			VAR ProductSales =
			    ADDCOLUMNS ( ALLSELECTED ( 'Clean_Data'[Product Name] ), "@Sales", [Total Sales] )
			VAR TotalSales = SUMX ( ProductSales, [@Sales] )
			VAR CumulativeSales =
			    SUMX ( FILTER ( ProductSales, [@Sales] >= CurrentSales ), [@Sales] )
			RETURN
			    IF (
			        ISINSCOPE ( 'Clean_Data'[Product Name] ) && NOT ISBLANK ( CurrentSales ),
			        DIVIDE ( CumulativeSales, TotalSales )
			    )
		formatString: 0.0%
		lineageTag: 31e90b3e-6244-4de0-9626-1af54d2d7940

	/// A = products that together make the first 80% of sales, B = the next 15%, C = the last 5%.
	measure 'ABC Class' =
			VAR CumulativeShare = [Cumulative Sales %]
			VAR CurrentSales = [Total Sales]
			VAR TotalSales = SUMX ( ALLSELECTED ( 'Clean_Data'[Product Name] ), [Total Sales] )
			VAR ShareBeforeThisProduct = CumulativeShare - DIVIDE ( CurrentSales, TotalSales )
			RETURN
			    IF (
			        NOT ISBLANK ( CumulativeShare ),
			        SWITCH ( TRUE (), ShareBeforeThisProduct < 0.80, "A", ShareBeforeThisProduct < 0.95, "B", "C" )
			    )
		lineageTag: c9df4dea-5abb-4a9e-bd7f-4083fef6aabd

	/// Discount that would apply if every line's discount rate were cut by the slider amount (never below 0%).
	measure 'Simulated Discount Amount' =
			VAR Cut = [Discount Cut Value] / 100
			RETURN
			    CALCULATE (
			        SUMX ( 'Clean_Data', 'Clean_Data'[Product Price] * 'Clean_Data'[Quantity] * MAX ( 0, 'Clean_Data'[Discount Rate] - Cut ) ),
			        'Clean_Data'[Is Cancelled] = "No"
			    )
		formatString: \$#,0
		lineageTag: f0314083-8132-4717-b54b-701db9929c58

	/// Sales if the discount cut were applied: gross sales minus the simulated discount.
	measure 'Simulated Sales' = ( [Total Sales] + [Total Discount Given] ) - [Simulated Discount Amount]
		formatString: \$#,0
		lineageTag: ff3b7988-cafc-47b7-9897-62b43858e3af

	/// Every dollar of discount removed becomes profit.
	measure 'Simulated Profit' = [Total Profit] + [Total Discount Given] - [Simulated Discount Amount]
		formatString: \$#,0
		lineageTag: 0dbd4b77-f059-4c58-b197-17f690632b9d

	/// Simulated profit minus actual profit.
	measure 'Profit Impact' = [Simulated Profit] - [Total Profit]
		formatString: +\$#,0;-\$#,0;\$0
		lineageTag: 5856df11-c30d-40e4-8922-1671a1d896eb

	/// Profit impact as a share of actual profit.
	measure 'Profit Impact %' = DIVIDE ( [Profit Impact], [Total Profit] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 45828429-51ff-4681-8b8b-4fc87580e04f

